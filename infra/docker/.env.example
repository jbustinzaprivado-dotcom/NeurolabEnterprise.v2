# Copia como infra/docker/.env (no se sube al repositorio) y cambia las claves.
POSTGRES_PASSWORD=cambia-esta-clave
MINIO_PASSWORD=cambia-esta-clave-de-minio
NEUROLAB_SECRET_KEY=cambia-esta-clave-larga-y-aleatoria
NEUROLAB_ENV=production
# Usuarios y proyectos demo (§17). Ponlo en false para un entorno sin datos de ejemplo.
NEUROLAB_SEED_DEMO=true
