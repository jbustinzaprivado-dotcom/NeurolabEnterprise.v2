# Copia como infra/docker/.env (no se sube al repositorio) y cambia las claves.
POSTGRES_PASSWORD=cambia-esta-clave
S3_PASSWORD=cambia-esta-clave-del-almacen-de-objetos
NEUROLAB_SECRET_KEY=cambia-esta-clave-larga-y-aleatoria
# Proveedor de identidad Keycloak (§11): base propia y cuenta `admin` de su consola.
KEYCLOAK_DB_PASSWORD=cambia-esta-clave-de-la-base-de-keycloak
KEYCLOAK_ADMIN_PASSWORD=cambia-esta-clave-del-administrador
NEUROLAB_ENV=production
# Usuarios y proyectos demo (§17). Ponlo en false para un entorno sin datos de ejemplo.
NEUROLAB_SEED_DEMO=true
