# Referencia de la configuración local (.env). El archivo .env real no se sube al repositorio.
# infra/postgres/crear_base.ps1 (lo llama run.bat) añade las URLs de PostgreSQL y la
# configuración de Keycloak con claves generadas al azar; el resto es opcional en desarrollo.

NEUROLAB_ENV=development
# Obligatoria (§5): base de trabajo en PostgreSQL.
# NEUROLAB_DATABASE_URL=postgresql+psycopg2://neurolab:<clave>@localhost:5432/neurolab
# Pruebas (§15): base aparte cuyo nombre termina en _test; se borra en cada ejecución.
# NEUROLAB_TEST_DATABASE_URL=postgresql+psycopg2://neurolab:<clave>@localhost:5432/neurolab_test
# NEUROLAB_SECRET_KEY=cambia-esto-en-produccion

# Proveedor de identidad (§11). crear_base.ps1 deja "oidc" con Keycloak en el puerto 8180
# (infra/keycloak/iniciar.ps1) y guarda aquí KEYCLOAK_DB_PASSWORD y KEYCLOAK_ADMIN_PASSWORD.
# Con "local" la API usa contraseñas propias y, en desarrollo, el acceso sin token.
# NEUROLAB_AUTH_PROVIDER=oidc
# NEUROLAB_OIDC_ISSUER=http://localhost:8180/realms/neurolab

# Solo con AUTH_PROVIDER=local: sin token, la API actúa como este usuario (solo desarrollo).
NEUROLAB_AUTH_DEV_BYPASS=true
NEUROLAB_DEV_USER_ID=USR-207
NEUROLAB_DEMO_PASSWORD=neurolab2026

# Almacenamiento de objetos (§5). En local, "local" usa la carpeta data/; con MinIO o AWS:
# NEUROLAB_STORAGE_BACKEND=s3
# NEUROLAB_S3_ENDPOINT=http://localhost:9000
# NEUROLAB_S3_BUCKET=neurolab
# NEUROLAB_S3_ACCESS_KEY=...
# NEUROLAB_S3_SECRET_KEY=...

# Límites
NEUROLAB_MAX_UPLOAD_MB=50
NEUROLAB_MAX_EPOCHS=500
NEUROLAB_MAX_ACTIVE_JOBS_PER_USER=3
NEUROLAB_MAX_JOB_SECONDS=1800
NEUROLAB_TRAINING_FAMILIES=FEEDFORWARD,RNN,CNN
