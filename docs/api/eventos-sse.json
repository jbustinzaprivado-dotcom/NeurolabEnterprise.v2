      "additionalProperties": false,
      "properties": {
        "createdAt": {
          "format": "date-time",
          "title": "Createdat",
          "type": "string"
        },
        "previous": {
          "anyOf": [
            {
              "enum": [
                "QUEUED",
                "PREPARING",
                "RUNNING",
                "COMPLETED",
                "FAILED",
                "CANCELLED"
