      "required": [
        "createdAt",
        "epoch",
        "epochs",
        "progress",
        "loss",
        "val_loss"
      ],
      "title": "MetricEvent",
      "type": "object"
    },
    "log": {
      "additionalProperties": false,
      "properties": {
        "createdAt": {
          "format": "date-time",
          "title": "Createdat",
          "type": "string"
