        "level": {
          "enum": [
            "info",
            "warn",
            "error",
            "success"
          ],
          "title": "Level",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "createdAt",
        "level",
        "message"
      ],
      "title": "LogEvent",
      "type": "object"
    },
    "end": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "COMPLETED",
            "FAILED",
            "CANCELLED"
