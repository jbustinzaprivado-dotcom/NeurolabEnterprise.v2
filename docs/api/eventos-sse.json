      "title": "StatusEvent",
      "type": "object"
    },
    "metric": {
      "additionalProperties": true,
      "description": "Fin de una época. Además de estos campos llegan las métricas de Keras de la tarea\n(`accuracy`, `val_accuracy`, `mae`, `f1`…), siempre numéricas.",
      "properties": {
        "createdAt": {
          "format": "date-time",
          "title": "Createdat",
          "type": "string"
        },
        "epoch": {
          "minimum": 1,
          "title": "Epoch",
          "type": "integer"
        },
        "epochs": {
          "minimum": 1,
          "title": "Epochs",
          "type": "integer"
        },
        "progress": {
          "maximum": 100,
          "minimum": 0,
          "title": "Progress",
          "type": "number"
        },
        "loss": {
          "title": "Loss",
          "type": "number"
        },
        "val_loss": {
          "title": "Val Loss",
          "type": "number"
        }
