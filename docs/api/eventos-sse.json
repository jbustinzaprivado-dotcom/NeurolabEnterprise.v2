        "datasetId",
        "datasetName",
        "datasetVersion",
        "targetColumn",
        "status",
        "statusReason",
        "priority",
        "epochs",
        "epoch",
        "batch",
        "optimizer",
        "learningRate",
        "seed",
        "loss",
        "accuracy",
        "valLoss",
        "valAccuracy",
        "progress",
        "queuedAt",
        "startedAt",
        "endedAt",
        "durationSeconds",
        "owner",
        "ownerId",
        "cancelRequested",
        "attempt",
        "retryOfId",
        "codeVersion",
        "modelVersionId"
